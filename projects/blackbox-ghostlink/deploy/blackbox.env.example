# Service environment template. Create a private /etc/blackbox/blackbox.env (0600).
BLACKBOX_HOST=127.0.0.1
BLACKBOX_PORT=8765
BLACKBOX_DB=/var/lib/blackbox/blackbox.sqlite3
# LAN mode (0.0.0.0) is refused without a token >=24 chars.
# BLACKBOX_TOKEN=<generate via python3 -c 'import secrets; print(secrets.token_urlsafe(32))'>
# BLACKBOX_NODE_KEY=<generate an independent token>
# Optional (the radio bridge is disabled by default, and every message needs manual release):
# BLACKBOX_MESH_ENABLED=1
# BLACKBOX_MESH_PORT=/dev/ttyUSB0
# Optional local read-only Home Assistant:
# BLACKBOX_HA_URL=http://192.168.1.143:8123
# BLACKBOX_HA_TOKEN=<HA long-lived access token>
# Optional model already installed in local Ollama runtime:
# BLACKBOX_OLLAMA_MODEL=<installed-local-model-name>
